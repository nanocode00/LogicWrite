{
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^IR-[0-9]{3}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "const": "ai_authored_non_unique_example_not_execution"
    },
    "bundle": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "document_id",
          "content",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "deferred_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "executed_by_system": {
      "const": false
    }
  },
  "required": [
    "case_id",
    "input_sha256",
    "kind",
    "bundle",
    "documents",
    "unresolved_questions",
    "deferred_scope",
    "executed_by_system"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
