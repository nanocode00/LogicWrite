{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "integrated-submission-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^IR-[0-9]{3}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_observation": {
      "type": "object",
      "properties": {
        "channel": {
          "enum": [
            "native_trace",
            "declared_plan",
            "unobserved"
          ]
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_before_edit": {
          "type": "boolean"
        },
        "explicit_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "inferred_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidence_based_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "document_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "document_id",
                    "start",
                    "end",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "summary",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "confirmation_needed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "channel",
        "artifact_sha256",
        "recorded_before_edit",
        "explicit_constraints",
        "inferred_requirements",
        "evidence_based_decisions",
        "confirmation_needed"
      ],
      "additionalProperties": false
    },
    "performed_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "document_id",
          "summary",
          "evidence_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "deferred_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "final_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "document_id",
          "content",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "validation_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unresolved",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "check",
          "status",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "execution_status": {
      "enum": [
        "complete",
        "partial",
        "failed",
        "not_run"
      ]
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "input_sha256",
    "decision_observation",
    "performed_changes",
    "deferred_changes",
    "final_documents",
    "validation_results",
    "execution_status"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
