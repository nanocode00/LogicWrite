{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent human review form v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "form_status": {
      "enum": [
        "blank",
        "submitted"
      ]
    },
    "case_id": {
      "type": "string",
      "pattern": "^SP-[0-9]{3}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "blinded_to_prior_judgments": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "judgment": {
      "enum": [
        null,
        "PRESERVED",
        "VIOLATION",
        "UNRESOLVED"
      ]
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error_type": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "none",
              "minor",
              "major",
              "critical",
              "undetermined"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "error_type",
          "severity",
          "reason"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "side": {
            "enum": [
              "source",
              "candidate"
            ]
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "side",
          "document_id",
          "start",
          "end",
          "quote"
        ]
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptable_alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "form_status",
    "case_id",
    "input_sha256",
    "reviewer_id",
    "reviewed_at",
    "blinded_to_prior_judgments",
    "judgment",
    "rationale",
    "findings",
    "evidence",
    "missing_information",
    "acceptable_alternatives"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "form_status": {
            "const": "blank"
          }
        }
      },
      "then": {
        "properties": {
          "reviewer_id": {
            "type": "null"
          },
          "reviewed_at": {
            "type": "null"
          },
          "blinded_to_prior_judgments": {
            "type": "null"
          },
          "judgment": {
            "type": "null"
          },
          "rationale": {
            "type": "null"
          },
          "findings": {
            "maxItems": 0
          },
          "evidence": {
            "maxItems": 0
          },
          "missing_information": {
            "maxItems": 0
          },
          "acceptable_alternatives": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "blinded_to_prior_judgments": {
            "type": "boolean"
          },
          "judgment": {
            "enum": [
              "PRESERVED",
              "VIOLATION",
              "UNRESOLVED"
            ]
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
