{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-user review with AI counterreview v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^SP-[0-9]{3}$"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ai_proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "const": "single_user_ai_counterreview"
    },
    "dataset_role": {
      "const": "development_only"
    },
    "confidence_limits": {
      "const": [
        "single_human_reviewer",
        "ai_assistance_is_not_independent_human_review",
        "not_independent_holdout"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "user_initial"
              },
              "actor_type": {
                "enum": [
                  "human",
                  "ai"
                ]
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "previous_event_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "form": {
                    "title": "Independent human review form v0.1",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "form_status": {
                        "const": "submitted"
                      },
                      "case_id": {
                        "type": "string",
                        "pattern": "^SP-[0-9]{3}$"
                      },
                      "input_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "reviewer_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1
                      },
                      "reviewed_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1
                      },
                      "blinded_to_prior_judgments": {
                        "type": [
                          "boolean",
                          "null"
                        ]
                      },
                      "judgment": {
                        "enum": [
                          null,
                          "PRESERVED",
                          "VIOLATION",
                          "UNRESOLVED"
                        ]
                      },
                      "rationale": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "minLength": 1
                      },
                      "findings": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "error_type": {
                              "type": "string",
                              "minLength": 1
                            },
                            "severity": {
                              "enum": [
                                "none",
                                "minor",
                                "major",
                                "critical",
                                "undetermined"
                              ]
                            },
                            "reason": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "error_type",
                            "severity",
                            "reason"
                          ]
                        }
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "side": {
                              "enum": [
                                "source",
                                "candidate"
                              ]
                            },
                            "document_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "side",
                            "document_id",
                            "start",
                            "end",
                            "quote"
                          ]
                        }
                      },
                      "missing_information": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "acceptable_alternatives": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "form_status",
                      "case_id",
                      "input_sha256",
                      "reviewer_id",
                      "reviewed_at",
                      "blinded_to_prior_judgments",
                      "judgment",
                      "rationale",
                      "findings",
                      "evidence",
                      "missing_information",
                      "acceptable_alternatives"
                    ],
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "form_status": {
                              "const": "blank"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "reviewer_id": {
                              "type": "null"
                            },
                            "reviewed_at": {
                              "type": "null"
                            },
                            "blinded_to_prior_judgments": {
                              "type": "null"
                            },
                            "judgment": {
                              "type": "null"
                            },
                            "rationale": {
                              "type": "null"
                            },
                            "findings": {
                              "maxItems": 0
                            },
                            "evidence": {
                              "maxItems": 0
                            },
                            "missing_information": {
                              "maxItems": 0
                            },
                            "acceptable_alternatives": {
                              "maxItems": 0
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "reviewer_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "reviewed_at": {
                              "type": "string",
                              "minLength": 1
                            },
                            "rationale": {
                              "type": "string",
                              "minLength": 1
                            },
                            "blinded_to_prior_judgments": {
                              "type": "boolean"
                            },
                            "judgment": {
                              "enum": [
                                "PRESERVED",
                                "VIOLATION",
                                "UNRESOLVED"
                              ]
                            },
                            "evidence": {
                              "minItems": 1
                            }
                          }
                        }
                      }
                    ]
                  },
                  "human_confirmed": {
                    "type": "boolean"
                  },
                  "ai_proposal_exposure": {
                    "enum": [
                      "seen",
                      "not_seen",
                      "unknown"
                    ]
                  }
                },
                "required": [
                  "form",
                  "human_confirmed",
                  "ai_proposal_exposure"
                ]
              }
            },
            "required": [
              "event_id",
              "kind",
              "actor_type",
              "actor_id",
              "recorded_at",
              "previous_event_sha256",
              "payload"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "ai_counterreview"
              },
              "actor_type": {
                "enum": [
                  "human",
                  "ai"
                ]
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "previous_event_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "separate_review": {
                    "type": "boolean"
                  },
                  "initial_event_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_scope": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "counterexamples",
                        "missing_conditions",
                        "contradictions"
                      ]
                    },
                    "minItems": 3
                  },
                  "challenges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "challenge_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "side": {
                                "enum": [
                                  "source",
                                  "candidate"
                                ]
                              },
                              "document_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "start": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "quote": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "side",
                              "document_id",
                              "start",
                              "end",
                              "quote"
                            ]
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "challenge_id",
                        "rationale",
                        "evidence"
                      ]
                    },
                    "minItems": 0
                  },
                  "no_challenge_reason": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1
                  }
                },
                "required": [
                  "model",
                  "separate_review",
                  "initial_event_id",
                  "review_scope",
                  "challenges",
                  "no_challenge_reason"
                ]
              }
            },
            "required": [
              "event_id",
              "kind",
              "actor_type",
              "actor_id",
              "recorded_at",
              "previous_event_sha256",
              "payload"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "user_final"
              },
              "actor_type": {
                "enum": [
                  "human",
                  "ai"
                ]
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "previous_event_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "counterreview_event_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "judgment": {
                    "enum": [
                      "PRESERVED",
                      "VIOLATION",
                      "UNRESOLVED"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "side": {
                          "enum": [
                            "source",
                            "candidate"
                          ]
                        },
                        "document_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "side",
                        "document_id",
                        "start",
                        "end",
                        "quote"
                      ]
                    },
                    "minItems": 1
                  },
                  "responses": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "challenge_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "decision": {
                          "enum": [
                            "accept",
                            "reject",
                            "defer"
                          ]
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "challenge_id",
                        "decision",
                        "rationale"
                      ]
                    },
                    "minItems": 0
                  },
                  "unresolved_issues": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "approve_for_development_gold": {
                    "type": "boolean"
                  },
                  "confidence_limitations": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "human_confirmed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "counterreview_event_id",
                  "judgment",
                  "rationale",
                  "evidence",
                  "responses",
                  "unresolved_issues",
                  "approve_for_development_gold",
                  "confidence_limitations",
                  "human_confirmed"
                ]
              }
            },
            "required": [
              "event_id",
              "kind",
              "actor_type",
              "actor_id",
              "recorded_at",
              "previous_event_sha256",
              "payload"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "reopen"
              },
              "actor_type": {
                "enum": [
                  "human",
                  "ai"
                ]
              },
              "actor_id": {
                "type": "string",
                "minLength": 1
              },
              "recorded_at": {
                "type": "string",
                "minLength": 1
              },
              "previous_event_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "human_confirmed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "reason",
                  "human_confirmed"
                ]
              }
            },
            "required": [
              "event_id",
              "kind",
              "actor_type",
              "actor_id",
              "recorded_at",
              "previous_event_sha256",
              "payload"
            ]
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "input_sha256",
    "ai_proposal_sha256",
    "method",
    "dataset_role",
    "confidence_limits",
    "events"
  ]
}
