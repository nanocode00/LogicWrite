{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "capability-input-v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CP-T[1-9]-[0-9]{2}$"
    },
    "task": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "title",
        "purpose",
        "audience",
        "deliverables"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "string",
          "minLength": 1
        },
        "output_document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "protected_regions": {
          "type": "string",
          "minLength": 1
        },
        "reference_date": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "authority",
        "requirements",
        "output_document_ids",
        "protected_regions",
        "reference_date"
      ],
      "additionalProperties": false
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "provided",
              "not_provided"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "excerpt",
              "unknown"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "synthetic",
                  "public_snapshot",
                  "controlled_public"
                ]
              },
              "source_key": {
                "type": "string",
                "minLength": 1
              },
              "transformations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "enum": [
                        "append",
                        "remove_first",
                        "move_to_end"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "operation",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "kind",
              "source_key",
              "transformations"
            ],
            "additionalProperties": false
          },
          "document_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "role",
          "content",
          "sha256",
          "availability",
          "completeness",
          "origin"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "destination_documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "provided",
              "not_provided"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "excerpt",
              "unknown"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "synthetic",
                  "public_snapshot",
                  "controlled_public"
                ]
              },
              "source_key": {
                "type": "string",
                "minLength": 1
              },
              "transformations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "enum": [
                        "append",
                        "remove_first",
                        "move_to_end"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "operation",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "kind",
              "source_key",
              "transformations"
            ],
            "additionalProperties": false
          },
          "document_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "role",
          "content",
          "sha256",
          "availability",
          "completeness",
          "origin"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "supporting_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "availability": {
            "enum": [
              "provided",
              "not_provided"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "excerpt",
              "unknown"
            ]
          },
          "origin": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "synthetic",
                  "public_snapshot",
                  "controlled_public"
                ]
              },
              "source_key": {
                "type": "string",
                "minLength": 1
              },
              "transformations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "enum": [
                        "append",
                        "remove_first",
                        "move_to_end"
                      ]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "operation",
                    "text"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "kind",
              "source_key",
              "transformations"
            ],
            "additionalProperties": false
          },
          "document_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "role",
          "content",
          "sha256",
          "availability",
          "completeness",
          "origin"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "availability": {
      "type": "object",
      "properties": {
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "external_material": {
          "const": "not_available"
        },
        "candidate_output": {
          "enum": [
            "fragment_only",
            "not_run"
          ]
        }
      },
      "required": [
        "gaps",
        "external_material",
        "candidate_output"
      ],
      "additionalProperties": false
    },
    "allowed_edit_scope": {
      "type": "object",
      "properties": {
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_ids",
        "operations",
        "limits"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "task",
    "contract",
    "source_documents",
    "destination_documents",
    "supporting_evidence",
    "availability",
    "allowed_edit_scope"
  ],
  "additionalProperties": false
}
