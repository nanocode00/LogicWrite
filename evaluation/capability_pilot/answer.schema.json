{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "capability-answer-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "provisional"
    },
    "author_type": {
      "const": "ai"
    },
    "gold_eligible": {
      "const": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "document_id": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "document_id",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "D": {
      "type": "object",
      "properties": {
        "obligations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "required_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "optional_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "required_effects": {
          "type": "object",
          "patternProperties": {
            "^[RF][0-9]+$": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "forbidden_effects": {
          "type": "object",
          "patternProperties": {
            "^[RF][0-9]+$": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        },
        "forbidden_outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "acceptable_alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "effects": {
                "type": "object",
                "patternProperties": {
                  "^[RF][0-9]+$": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              "bundle_policy": {
                "const": "complete_bundle_no_cherry_picking"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "description",
              "effects",
              "bundle_policy",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "applicability": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "applicable",
                "unresolved"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        },
        "observation": {
          "type": "object",
          "properties": {
            "accepted_channels": {
              "const": [
                "native_trace",
                "declared_plan"
              ]
            },
            "natural_run_without_trace": {
              "const": "unobserved"
            },
            "output_effect": {
              "const": "auxiliary_only"
            },
            "submission_before_edit": {
              "const": true
            }
          },
          "required": [
            "accepted_channels",
            "natural_run_without_trace",
            "output_effect",
            "submission_before_edit"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "obligations",
        "relations",
        "required_decisions",
        "optional_decisions",
        "required_effects",
        "forbidden_effects",
        "forbidden_outcomes",
        "acceptable_alternatives",
        "unresolved_questions",
        "applicability",
        "observation"
      ],
      "additionalProperties": false
    },
    "Q": {
      "type": "object",
      "properties": {
        "applicability": {
          "enum": [
            "not_evaluated_incomplete",
            "requires_complete_candidate_output",
            "unresolved_contract"
          ]
        },
        "protected_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "task_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "criterion",
              "evidence_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "whole_document_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "rubric_anchors": {
          "type": "object",
          "properties": {
            "information_preservation": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "purpose_fit": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "completeness": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "placement": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4
            },
            "expression": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 4,
              "maxItems": 4
            }
          },
          "required": [
            "information_preservation",
            "purpose_fit",
            "completeness",
            "placement",
            "expression"
          ],
          "additionalProperties": false
        },
        "trace_requirements": {
          "type": "string",
          "minLength": 1
        },
        "unseen_valid_answer_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "applicability",
        "protected_facts",
        "task_checks",
        "whole_document_constraints",
        "rubric_anchors",
        "trace_requirements",
        "unseen_valid_answer_policy"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "properties": {
        "D": {
          "type": "object",
          "properties": {
            "required_decision_recall": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "string",
                  "minLength": 1
                },
                "denominator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            },
            "forbidden_outcome_count": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "string",
                  "minLength": 1
                },
                "denominator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            },
            "evidence_precision": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "string",
                  "minLength": 1
                },
                "denominator": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    }
                  ]
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            },
            "abstention": {
              "type": "object",
              "properties": {
                "expected": {
                  "type": "boolean"
                },
                "execution_failure_is_abstention": {
                  "const": false
                }
              },
              "required": [
                "expected",
                "execution_failure_is_abstention"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "required_decision_recall",
            "forbidden_outcome_count",
            "evidence_precision",
            "abstention"
          ],
          "additionalProperties": false
        },
        "Q": {
          "type": "object",
          "properties": {
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 5
            },
            "range": {
              "const": [
                0,
                3
              ]
            },
            "aggregate_DQ": {
              "const": false
            },
            "zero_denominator": {
              "const": "N/A"
            },
            "missing_output": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "dimensions",
            "range",
            "aggregate_DQ",
            "zero_denominator",
            "missing_output"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "D",
        "Q"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "input_sha256",
    "status",
    "author_type",
    "gold_eligible",
    "evidence",
    "D",
    "Q",
    "metrics"
  ],
  "additionalProperties": false
}
