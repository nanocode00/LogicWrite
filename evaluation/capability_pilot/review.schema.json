{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "capability-review-v1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "provisional"
    },
    "initial_ai_proposal": {
      "type": "string",
      "minLength": 1
    },
    "independent_ai_counterreview": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "case_pointer": {
              "type": "string",
              "minLength": 1
            },
            "reviewed_input_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "superseded_input": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "sha256",
            "case_pointer",
            "reviewed_input_sha256",
            "superseded_input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "human_initial_reviews": {
      "const": []
    },
    "independent_human_counterexample": {
      "type": "null"
    },
    "human_final_judgment": {
      "type": "null"
    },
    "adjudication": {
      "type": "null"
    },
    "gold_inclusion_approval": {
      "type": "null"
    },
    "human_review_requirement": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "input_sha256",
    "status",
    "initial_ai_proposal",
    "independent_ai_counterreview",
    "human_initial_reviews",
    "independent_human_counterexample",
    "human_final_judgment",
    "adjudication",
    "gold_inclusion_approval",
    "human_review_requirement"
  ],
  "additionalProperties": false
}
