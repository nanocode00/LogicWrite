{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development gold inclusion intent history; no activation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "gold-inclusion-intent-history-v1"
    },
    "basis_commit": {
      "const": "2bee75af63a0c26a3b3c44c6605d67b2ffbb4bf7"
    },
    "events": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "user_development_gold_inclusion_approval_recorded"
          },
          "actor_type": {
            "const": "human"
          },
          "recorder_type": {
            "const": "ai"
          },
          "user_approved_at": {
            "const": null
          },
          "signature": {
            "const": null
          },
          "authentication": {
            "const": null
          },
          "approve_for_development_gold": {
            "const": true
          },
          "activate_development_gold": {
            "const": false
          },
          "event_id": {
            "type": "string",
            "pattern": "^gold-inclusion-intent-(GC|SP)-[0-9]{3}$"
          },
          "case_id": {
            "enum": [
              "GC-001",
              "GC-002",
              "GC-003",
              "GC-004",
              "GC-005",
              "GC-006",
              "GC-007",
              "GC-008",
              "GC-009",
              "GC-010",
              "GC-011",
              "GC-012",
              "SP-013",
              "SP-014",
              "SP-015",
              "SP-016",
              "SP-017"
            ]
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "declaration_reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "required": [
              "path",
              "sha256",
              "pointer"
            ]
          },
          "final_reference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "pointer": {
                "type": "string",
                "pattern": "^/"
              }
            },
            "required": [
              "path",
              "sha256",
              "pointer"
            ]
          },
          "final_event_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "previous_event_sha256": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            ]
          }
        },
        "required": [
          "kind",
          "actor_type",
          "recorder_type",
          "user_approved_at",
          "signature",
          "authentication",
          "approve_for_development_gold",
          "activate_development_gold",
          "event_id",
          "case_id",
          "input_sha256",
          "declaration_reference",
          "final_reference",
          "final_event_sha256",
          "previous_event_sha256"
        ]
      }
    },
    "terminal_event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "basis_commit",
    "events",
    "terminal_event_sha256"
  ]
}
