{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "core-document-set-v1"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "context": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "audience": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "purpose": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "explicit_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "pending_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "origin": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "source_id",
        "input_sha256",
        "format"
      ],
      "additionalProperties": false
    },
    "document_set_completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "role": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "audience": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "purpose": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "authority": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "access": {
            "enum": [
              "edit",
              "format_only",
              "read_only",
              "pending"
            ]
          },
          "completeness": {
            "enum": [
              "complete",
              "excerpt",
              "unknown"
            ]
          },
          "source_scope": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "supplied_snapshot"
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "snapshot_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "kind",
              "source_id",
              "path",
              "snapshot_sha256"
            ],
            "additionalProperties": false
          },
          "output_target": {
            "type": "boolean"
          },
          "explicit_constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "pending_questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "required": [
          "document_id",
          "role",
          "audience",
          "purpose",
          "authority",
          "access",
          "completeness",
          "source_scope",
          "content",
          "sha256",
          "provenance",
          "output_target",
          "explicit_constraints",
          "pending_questions"
        ],
        "additionalProperties": false
      }
    },
    "output_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "document_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "scope_id",
          "document_id"
        ],
        "additionalProperties": false
      }
    },
    "additional_permissions": {
      "type": "object",
      "properties": {
        "external_lookup": {
          "const": "not_granted"
        },
        "create_document": {
          "const": "not_granted"
        },
        "apply_files": {
          "const": "not_granted"
        }
      },
      "required": [
        "external_lookup",
        "create_document",
        "apply_files"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "reviewable_candidate_only"
        },
        "required": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "mode",
        "required"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "request",
    "context",
    "audience",
    "purpose",
    "explicit_constraints",
    "pending_questions",
    "origin",
    "document_set_completeness",
    "documents",
    "output_scopes",
    "additional_permissions",
    "delivery"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
